<form method="post" action="{{ action }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />

    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title"><i class="ti ti-qrcode me-2"></i>{{ __('QR code templates', 'assetqr') }}</h3>
        </div>
        <div class="card-body">
            <p class="text-muted">
                {{ __('Placeholders in curly braces are replaced by the asset values, e.g. {name}, {serial}. Foreign keys such as {manufacturers_id} or {users_id} are resolved to their names. Additionally available: {id}, {itemtype}, {url}, {entity}. Empty lines are removed.', 'assetqr') }}
            </p>

            <label class="form-label fw-bold" for="template_default">{{ __('Default template', 'assetqr') }}</label>
            <textarea class="form-control font-monospace mb-1" rows="7" id="template_default" name="template_default" maxlength="{{ max_length }}">{{ template_default }}</textarea>
            <div class="form-hint mb-4">{{ __('Used for all asset types without their own template.', 'assetqr') }}</div>

            {% set empty_hint = __('Empty = use default template', 'assetqr') %}
            <div class="accordion" id="assetqr-templates">
                {% for type in types %}
                    {% set has_template = type.template|trim is not empty %}
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#assetqr-type-{{ loop.index0 }}">
                                {{ type.label }}
                                {% if has_template %}
                                    <span class="badge bg-green-lt ms-2">{{ __('Own template', 'assetqr') }}</span>
                                {% endif %}
                            </button>
                        </h2>
                        <div id="assetqr-type-{{ loop.index0 }}" class="accordion-collapse collapse" data-bs-parent="#assetqr-templates">
                            <div class="accordion-body">
                                <textarea class="form-control font-monospace mb-2" rows="5" name="templates[{{ type.itemtype }}]" maxlength="{{ max_length }}"
                                    placeholder="{{ empty_hint }}">{{ type.template }}</textarea>
                                <div class="small text-muted">
                                    {{ __('Available placeholders:', 'assetqr') }}
                                    {% for placeholder in type.placeholders %}
                                        <code>{{ '{' ~ placeholder ~ '}' }}</code>{{ not loop.last ? ' ' }}
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title"><i class="ti ti-printer me-2"></i>{{ __('Labels', 'assetqr') }}</h3>
        </div>
        <div class="card-body">
            <p class="text-muted">
                {{ __('Layout of the labels when printing the QR codes of several assets (massive action "Print QR codes").', 'assetqr') }}
            </p>

            {% set number_fields = [
                {key: 'label_width', label: __('Label width', 'assetqr'), unit: 'mm'},
                {key: 'label_height', label: __('Label height', 'assetqr'), unit: 'mm', hint: __('0 = as high as the content', 'assetqr')},
                {key: 'label_qr_size', label: __('QR code size', 'assetqr'), unit: 'mm'},
                {key: 'label_font_size', label: __('Font size', 'assetqr'), unit: 'pt'},
                {key: 'label_gap', label: __('Gap between labels', 'assetqr'), unit: 'mm'},
            ] %}
            <div class="row g-3 mb-3">
                {% for field in number_fields %}
                    <div class="col-sm-6 col-lg-4">
                        <label class="form-label" for="{{ field.key }}">{{ field.label }}</label>
                        <div class="input-group">
                            <input type="number" class="form-control" id="{{ field.key }}" name="{{ field.key }}" required
                                value="{{ label[field.key] }}" min="{{ label_numbers[field.key][1] }}" max="{{ label_numbers[field.key][2] }}" step="1" />
                            <span class="input-group-text">{{ field.unit }}</span>
                        </div>
                        {% if field.hint is defined %}
                            <div class="form-hint">{{ field.hint }}</div>
                        {% endif %}
                    </div>
                {% endfor %}
                <div class="col-sm-6 col-lg-4">
                    <label class="form-label" for="label_layout">{{ __('Text', 'assetqr') }}</label>
                    <select class="form-select" id="label_layout" name="label_layout">
                        {% for value, text in {
                            below: __('Below the QR code', 'assetqr'),
                            beside: __('Beside the QR code', 'assetqr'),
                            none: __('No text', 'assetqr'),
                        } %}
                            <option value="{{ value }}" {{ label.label_layout == value ? 'selected' }}>{{ text }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <label class="form-check form-switch">
                <input type="hidden" name="label_border" value="0" />
                <input class="form-check-input" type="checkbox" name="label_border" value="1" {{ label.label_border ? 'checked' }} />
                <span class="form-check-label">{{ __('Print cutting frame', 'assetqr') }}</span>
            </label>
        </div>
        <div class="card-footer d-flex flex-row-reverse">
            <button type="submit" name="update" value="1" class="btn btn-primary">
                <i class="ti ti-device-floppy"></i>
                <span>{{ _x('button', 'Save') }}</span>
            </button>
        </div>
    </div>
</form>
