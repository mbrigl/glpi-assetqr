{% if error %}
    <div class="alert alert-danger mb-0">
        <i class="ti ti-alert-triangle me-1"></i>
        {{ __('QR code could not be generated:', 'assetqr') }} {{ error }}
    </div>
{% else %}
    <div class="assetqr-qrcode text-center">
        <div class="assetqr-qrcode-image mx-auto mb-3" style="max-width: 320px">
            {# SVG embedded as an image: markup inside it can never be interpreted by the page #}
            <img class="w-100 h-auto" src="data:image/svg+xml;base64,{{ svg }}" alt="{{ text }}" />
        </div>
        <pre class="text-start bg-light border rounded p-2 mb-3" style="white-space: pre-wrap">{{ text }}</pre>
        <div class="d-flex justify-content-center gap-2">
            <a class="btn btn-primary" href="data:image/png;base64,{{ png }}" download="{{ filename }}">
                <i class="ti ti-download"></i>
                <span>{{ __('Download PNG', 'assetqr') }}</span>
            </a>
            <button type="button" class="btn btn-outline-secondary assetqr-qrcode-print" data-title="{{ __('QR code', 'assetqr') }}">
                <i class="ti ti-printer"></i>
                <span>{{ __('Print') }}</span>
            </button>
        </div>
    </div>
{% endif %}
