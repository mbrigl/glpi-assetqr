#: templates/config.html.twig:34
msgid "QR code templates"
msgstr "QR-Code-Vorlagen"

#: templates/config.html.twig:38
#, python-brace-format
msgid "Placeholders in curly braces are replaced by the asset values, e.g. {name}, {serial}. Foreign keys such as {manufacturers_id} or {users_id} are resolved to their names. Additionally available: {id}, {itemtype}, {url}, {entity}. Empty lines are removed."
msgstr "Platzhalter in geschweiften Klammern werden durch die Werte des Assets ersetzt, z. B. {name}, {serial}. Fremdschlüssel wie {manufacturers_id} oder {users_id} werden zu ihren Namen aufgelöst. Zusätzlich verfügbar: {id}, {itemtype}, {url}, {entity}. Leere Zeilen werden entfernt."

