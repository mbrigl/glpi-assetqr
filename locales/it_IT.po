#: templates/config.html.twig:38
#, python-brace-format
msgid "Placeholders in curly braces are replaced by the asset values, e.g. {name}, {serial}. Foreign keys such as {manufacturers_id} or {users_id} are resolved to their names. Additionally available: {id}, {itemtype}, {url}, {entity}. Empty lines are removed."
msgstr "I segnaposto tra parentesi graffe vengono sostituiti dai valori dell'asset, ad es. {name}, {serial}. Le chiavi esterne come {manufacturers_id} o {users_id} vengono sostituite dai rispettivi nomi. Disponibili inoltre: {id}, {itemtype}, {url}, {entity}. Le righe vuote vengono rimosse."

