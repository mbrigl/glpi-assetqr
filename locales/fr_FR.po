msgstr "Trop d'actifs sélectionnés : au maximum %d codes QR peuvent être imprimés à la fois."

#: templates/config.html.twig:37
msgid "QR code templates"
msgstr "Modèles de code QR"

#: templates/config.html.twig:41
#, python-brace-format
msgid "Placeholders in curly braces are replaced by the asset values, e.g. {name}, {serial}. Foreign keys such as {manufacturers_id} or {users_id} are resolved to their names. Additionally available: {id}, {itemtype}, {url}, {entity}. Empty lines are removed."
msgstr "Les espaces réservés entre accolades sont remplacés par les valeurs de l'actif, p. ex. {name}, {serial}. Les clés étrangères comme {manufacturers_id} ou {users_id} sont remplacées par leur nom. Également disponibles : {id}, {itemtype}, {url}, {entity}. Les lignes vides sont supprimées."

#: templates/config.html.twig:44
msgid "Default template"
msgstr "Modèle par défaut"

#: templates/config.html.twig:46
