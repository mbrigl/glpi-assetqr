#: templates/config.html.twig:38
#, python-brace-format
msgid "Placeholders in curly braces are replaced by the asset values, e.g. {name}, {serial}. Foreign keys such as {manufacturers_id} or {users_id} are resolved to their names. Additionally available: {id}, {itemtype}, {url}, {entity}. Empty lines are removed."
msgstr "Los marcadores entre llaves se sustituyen por los valores del activo, p. ej. {name}, {serial}. Las claves externas como {manufacturers_id} o {users_id} se sustituyen por sus nombres. También disponibles: {id}, {itemtype}, {url}, {entity}. Las líneas vacías se eliminan."

