{
    "name": "mbrigl/glpi-assetqr",
    "description": "GLPI plugin: QR codes for assets with configurable content",
    "type": "glpi-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Markus Brigl"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l > /dev/null",
        "cs": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix"
    }
}
